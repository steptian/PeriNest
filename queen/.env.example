# PeriNest Queen 环境变量模板 — 复制为 .env 后填写
# 全部变量加前缀 PERINEST_Q_，例：PERINEST_Q_DB_HOST

PERINEST_Q_DEBUG=true
PERINEST_Q_SECRET_KEY=change_me_in_prod
PERINEST_Q_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Core 腺体 (MySQL 8)
PERINEST_Q_DB_HOST=127.0.0.1
PERINEST_Q_DB_PORT=3306
PERINEST_Q_DB_USER=perinest
PERINEST_Q_DB_PASSWORD=change_me
PERINEST_Q_DB_NAME=perinest_db

# Nectar 花蜜 (Redis)
PERINEST_Q_REDIS_URL=redis://127.0.0.1:6379/0

# Pheromone (Celery)
PERINEST_Q_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
PERINEST_Q_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Antenna 微信小程序
PERINEST_Q_WX_APPID=
PERINEST_Q_WX_SECRET=

# CORS（Wing 开发地址）
PERINEST_Q_CORS_ORIGINS=["http://localhost:5173"]

# Nerve 神经索 (AI 网关 — 任意 OpenAI 兼容服务)
# 留空 AI_API_KEY 即 mock 模式（demo/CI 零成本）
PERINEST_Q_AI_API_BASE=https://api.deepseek.com/v1
PERINEST_Q_AI_API_KEY=
PERINEST_Q_AI_MODEL=deepseek-chat
