# /etc/systemd/system/perinest-queen.service
# 安装：cp perinest-queen.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now perinest-queen
[Unit]
Description=PeriNest Queen (FastAPI + Gunicorn)
After=network.target mysql.service redis.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/perinest/queen
Environment="PATH=/opt/perinest/queen/.venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/opt/perinest/queen/.env
ExecStart=/opt/perinest/queen/.venv/bin/gunicorn -c /opt/perinest/queen/gunicorn.conf.py app.main:app
ExecReload=/bin/kill -s HUP $MAINPID
# 断头再生：崩溃自动拉起
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=30
StandardOutput=append:/var/log/perinest/queen.out.log
StandardError=append:/var/log/perinest/queen.err.log
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
