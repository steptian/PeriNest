<view class="specimen-card user-header">
  <view class="avatar btn-amber font-specimen">{{isLoggedIn ? (username ? username[0] : "·") : "·"}}</view>
  <view class="nickname font-specimen">{{isLoggedIn ? (username || "已入巢成员") : "未入巢"}}</view>
  <view class="specimen-latin">{{isLoggedIn ? "specimen keeper" : "not logged in"}}</view>
  <view class="version font-specimen">PeriNest Antenna v{{appVersion}}</view>
</view>
<navigator wx:if="{{!isLoggedIn}}" url="/pages/login/login" class="specimen-card" style="text-align: center;">
  <text class="login-link">进入巢穴 · 登录</text>
</navigator>
<view wx:else class="specimen-card" bindtap="logout" style="text-align: center;">
  <text class="leave">离巢</text>
</view>
