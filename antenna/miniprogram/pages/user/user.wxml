<view class="specimen-card user-header">
  <view class="avatar btn-amber font-specimen">{{isLoggedIn ? (username ? username[0] : "·") : "·"}}</view>
  <view class="nickname font-specimen">{{nickname}}</view>
  <view class="specimen-latin">{{isLoggedIn ? "specimen keeper" : "not logged in"}}</view>
  <navigator url="/pages/changelog/changelog" class="version font-specimen">PeriNest Antenna v{{appVersion}} · {{i18n.version}}</navigator>
</view>
<view class="specimen-card lang-card">
  <view class="lang-head">
    <view class="specimen-latin">language</view>
    <view class="lang-title">{{i18n.language}}</view>
  </view>
  <view class="lang-pills">
    <view wx:for="{{langs}}" wx:key="code"
      class="lang-pill {{item.code === lang ? 'lang-pill-on' : ''}}"
      bindtap="onSetLang" data-code="{{item.code}}">{{item.label}}</view>
  </view>
</view>
<navigator wx:if="{{!isLoggedIn}}" url="/pages/login/login" class="specimen-card" style="text-align: center;">
  <text class="login-link">{{i18n.login}}</text>
</navigator>
<view wx:else class="specimen-card" bindtap="logout" style="text-align: center;">
  <text class="leave">{{i18n.logout}}</text>
</view>
