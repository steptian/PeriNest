  <view class="nickname font-specimen">{{userInfo ? userInfo.nickName : "未登录"}}</view>
  <view class="specimen-latin">specimen keeper</view>
  <view class="version font-specimen">PeriNest Antenna v{{appVersion}}</view>
</view>
<view class="specimen-card" bindtap="logout" style="text-align: center;">
  <text class="leave">离巢</text>
</view>
