<!-- 未登录占位 -->
<view wx:if="{{!isLoggedIn}}" class="empty-container">
  <image class="empty-icon" src="/images/icons/empty-box.png" mode="aspectFit" />
  <text class="empty-text">{{i18n.needLogin}}</text>
  <navigator url="/pages/login/login" class="empty-btn">{{i18n.goLogin}}</navigator>
</view>
<!-- 空态占位 -->
<view wx:elif="{{orders.length === 0 && !loading}}" class="empty-container">
  <image class="empty-icon" src="/images/icons/empty-box.png" mode="aspectFit" />
  <text class="empty-text">{{i18n.empty}}</text>
  <navigator url="/pages/chat/chat" open-type="switchTab" class="empty-btn">{{i18n.goChat}}</navigator>
</view>
<!-- 订单列表 -->
<view wx:for="{{orders}}" wx:key="id" class="specimen-card">
  <view class="row-head">
    <text class="specimen-latin">no.{{index + 1}}</text>
    <text class="amount font-specimen">￥{{item.total_amount}}</text>
  </view>
  <view class="row-main">
    <text class="status badge-amber">{{statusLabel[item.status]}}</text>
    <text class="count">{{item.items.length}} {{i18n.itemUnit}}</text>
  </view>
  <view class="order-no font-specimen">{{item.order_no}}</view>
</view>
