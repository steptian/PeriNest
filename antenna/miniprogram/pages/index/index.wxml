<view class="specimen-card welcome-card">
  <view class="specimen-latin">{{today}} · nest registry</view>
  <view class="welcome-title font-specimen">{{welcomeTitle}}</view>
  <view class="slogan">built to survive, designed to adapt.</view>
</view>

<view class="specimen-card">
  <view class="specimen-latin">assistant · ask</view>
  <view class="section-title font-specimen">{{i18n.kbTitle}}</view>
  <view class="hint">{{i18n.askHint}}</view>
  <navigator url="/pages/chat/chat" open-type="switchTab" class="btn-amber main-cta">{{i18n.askCta}}</navigator>
</view>

<view class="specimen-card">
  <view class="specimen-latin">crop · knowledge</view>
  <view class="section-title font-specimen">{{i18n.kbAskTitle}}</view>
  <view class="hint">{{i18n.kbAskHint}}</view>
  <navigator url="/pages/chat/chat" open-type="switchTab" class="btn-amber main-cta">{{i18n.kbAskCta}}</navigator>
</view>

<view class="specimen-card">
  <view class="specimen-latin">recent specimens</view>
  <view class="section-title font-specimen">{{i18n.recent}}</view>
  <block wx:if="{{recentOrders.length}}">
    <view wx:for="{{recentOrders}}" wx:key="id" class="order-row" bindtap="goOrders">
      <view class="order-no font-specimen">#{{item.order_no}}</view>
      <view class="badge-amber">{{item.statusLabel}}</view>
      <view class="order-amount font-specimen">¥{{item.total_amount}}</view>
    </view>
    <navigator url="/pages/order/order" open-type="switchTab" class="more-link">{{i18n.viewAll}}</navigator>
  </block>
  <view wx:else class="empty-text">{{i18n.empty}}</view>
</view>

<view class="specimen-card lore-card">
  <view class="specimen-latin">compendium</view>
  <view class="lore">{{i18n.quote}}</view>
  <view class="lore-sub">{{i18n.quoteSub}}</view>
</view>
