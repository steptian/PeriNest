.chat-scroll { height: calc(100vh - 200rpx); padding: 24rpx; box-sizing: border-box; }
.msg-row { display: flex; margin-bottom: 28rpx; }
.msg-right { justify-content: flex-end; }
.msg { max-width: 78%; border-radius: 24rpx; padding: 22rpx 26rpx; }
.msg-ai {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 24rpx 24rpx 24rpx 8rpx;
}
.msg-user {
  background: linear-gradient(160deg, var(--amber), var(--amber-light));
  color: #fff8ee;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  box-shadow: 0 12rpx 32rpx -12rpx rgba(180, 86, 12, 0.5);
}
.msg-text { font-size: 28rpx; line-height: 1.6; display: block; word-break: break-all; }
.msg-ai .specimen-latin { display: block; margin-bottom: 8rpx; }
.chat-input-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; gap: 16rpx; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1px solid var(--line);
}
.chat-input {
  flex: 1; width: 100%; box-sizing: border-box;
  background: var(--card); border: 1rpx solid var(--line);
  border-radius: 24rpx; padding: 16rpx 32rpx; font-size: 28rpx;
  min-height: 72rpx; line-height: 1.5;   /* auto-height 撑高；空态与按钮对齐 */
}
.chat-send {
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;   /* 与 height 等值：修微信 button 默认高度导致的文本偏移 */
  font-size: 26rpx;
  margin: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* AI 助手头部控制（合并版） */
.ctl-bar {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 8rpx 8rpx;
}
.kb-toggle, .mode-toggle {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border, rgba(0, 0, 0, 0.12));
  color: var(--muted, #8a7a66);
}
.kb-toggle.kb-on {
  border-color: var(--primary, #b4560c);
  color: var(--primary, #b4560c);
  background: rgba(180, 86, 12, 0.08);
}
.mode-toggle.mode-on {
  border-color: var(--primary, #b4560c);
  color: var(--primary, #b4560c);
}
.step-text {
  display: block;
  font-size: 20rpx;
  color: var(--muted, #8a7a66);
  margin: 2rpx 0;
}
.citations {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--border, rgba(0, 0, 0, 0.08));
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cite-title { font-size: 18rpx; opacity: 0.6; }
.cite-item { font-size: 22rpx; color: var(--muted, #8a7a66); }
.hit-card { margin: 16rpx 0; padding: 24rpx; }
.hit-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10rpx; }
.hit-src { font-size: 22rpx; font-weight: 600; }
.hit-content { font-size: 24rpx; line-height: 1.6; }
.empty-guide { padding: 100rpx 40rpx; text-align: center; }
.empty-main { font-size: 26rpx; color: var(--muted, #8a7a66); }

/* markdown 富渲染（md-lite 结构块） */
.md-block { margin: 6rpx 0; }
.md-h { display: block; font-weight: 700; margin: 12rpx 0 6rpx; }
.md-h1 { font-size: 32rpx; }
.md-h2 { font-size: 30rpx; }
.md-h3 { font-size: 28rpx; }
.md-p { display: block; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; }
.md-list { margin: 8rpx 0; }
.md-li { display: flex; margin: 4rpx 0; font-size: 27rpx; line-height: 1.6; }
.md-bullet { color: var(--primary, #b4560c); margin-right: 8rpx; flex-shrink: 0; }
.md-quote { border-left: 4rpx solid rgba(180, 86, 12, 0.5); padding-left: 16rpx; color: var(--muted, #8a7a66); margin: 10rpx 0; font-size: 26rpx; }
.md-hr { border-top: 1rpx solid rgba(0, 0, 0, 0.1); margin: 14rpx 0; }
.md-codeblock { background: rgba(0, 0, 0, 0.05); border-radius: 12rpx; padding: 16rpx; margin: 10rpx 0; overflow-x: auto; }
.md-codetext { font-family: Menlo, Consolas, monospace; font-size: 24rpx; line-height: 1.6; white-space: pre; }
.md-bold { font-weight: 700; }
.md-italic { font-style: italic; }
.md-code { font-family: Menlo, Consolas, monospace; font-size: 0.92em; padding: 2rpx 8rpx; border-radius: 6rpx; background: rgba(0, 0, 0, 0.06); }
.md-link { color: var(--primary, #b4560c); text-decoration: underline; }

/* 历史会话入口与弹层 */
.hist-btn {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border, rgba(0, 0, 0, 0.12));
  color: var(--muted, #8a7a66);
}
.hist-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(0, 0, 0, 0.4);
  display: flex; align-items: flex-end;
}
.hist-sheet {
  width: 100%; max-height: 68vh;
  background: var(--card, #f7f1e5);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex; flex-direction: column;
}
.hist-head {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20rpx;
}
.hist-title { font-size: 32rpx; font-weight: 700; }
.hist-new {
  font-size: 24rpx; color: #fff;
  background: var(--primary, #b4560c);
  border-radius: 999rpx; padding: 8rpx 24rpx;
}
.hist-list { max-height: 56vh; }
.hist-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid var(--border, rgba(0, 0, 0, 0.06));
}
.hist-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.hist-item-title { font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hist-item-meta { font-size: 20rpx; color: var(--muted, #8a7a66); }
.hist-rename { padding: 12rpx; color: var(--muted, #8a7a66); font-size: 26rpx; }
