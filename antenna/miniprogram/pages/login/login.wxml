<view class="login-wrap">
  <image src="/images/logo.png" class="login-logo" mode="aspectFit" />
  <view class="specimen-latin">periplaneta · antenna</view>
  <view class="login-title font-specimen">PeriNest</view>
  <view class="login-slogan">built to survive, designed to adapt.</view>

  <view class="login-card">
    <view class="specimen-latin">{{i18n.username}}</view>
    <input class="login-input" placeholder="your-name" value="{{username}}" bindinput="onUser" />
    <view class="specimen-latin pwd-label">{{i18n.password}}</view>
    <input class="login-input" password placeholder="••••••••" value="{{password}}" bindinput="onPwd" bindconfirm="pwdLogin" />
    <view wx:if="{{error}}" class="login-error">{{error}}</view>
    <button class="btn-amber login-btn" loading="{{loading}}" bindtap="pwdLogin">{{i18n.enter}}</button>

    <view class="login-divider"><text class="specimen-latin">or</text></view>
    <button class="login-wx-btn" open-type="getUserInfo" bindtap="wxLogin">
      <text class="login-wx-dot"/><text>{{i18n.wxLogin}}</text>
    </button>
    <view class="login-hint">{{i18n.wxHint}}</view>
  </view>
</view>
