/* 嗦囊知识库页 —— 沿用全局 specimen-card / btn-amber 令牌，页内仅补充布局 */
.chat-scroll {
  height: calc(100vh - 120rpx);
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 模式切换 */
.mode-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0 8rpx;
}
.mode-btn {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border, rgba(0, 0, 0, 0.12));
  color: var(--muted, #8a7a66);
}
.mode-btn.mode-on {
  background: var(--primary, #b4560c);
  border-color: var(--primary, #b4560c);
  color: #fff;
}

/* 检索过程行 */
.step-row {
  margin: 12rpx 0;
}
.step-text {
  font-size: 22rpx;
  color: var(--muted, #8a7a66);
}

/* 作答卡片 */
.answer-card {
  margin: 16rpx 0;
  padding: 28rpx;
}
.answer-text {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
.citations {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border, rgba(0, 0, 0, 0.08));
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.cite-title {
  font-size: 18rpx;
  opacity: 0.6;
}
.cite-item {
  font-size: 22rpx;
  color: var(--muted, #8a7a66);
}

/* 检索命中卡片 */
.hit-card {
  margin: 16rpx 0;
  padding: 24rpx;
}
.hit-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}
.hit-src {
  font-size: 22rpx;
  font-weight: 600;
}
.hit-content {
  font-size: 24rpx;
  line-height: 1.6;
}

/* 错误 / 空态 */
.error-card {
  margin: 16rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(180, 40, 40, 0.3);
  background: rgba(180, 40, 40, 0.08);
  color: #b42828;
  font-size: 26rpx;
}
.empty-guide {
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-main {
  font-size: 26rpx;
  color: var(--muted, #8a7a66);
}
.empty-text {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted, #8a7a66);
}

/* 输入条（与 chat 页一致） */
.chat-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card, #f7f1e5);
  border-top: 1rpx solid var(--border, rgba(0, 0, 0, 0.08));
}
.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border, rgba(0, 0, 0, 0.12));
  font-size: 28rpx;
}
.chat-send {
  width: 140rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  font-size: 26rpx;
}
