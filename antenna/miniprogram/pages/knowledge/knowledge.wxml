<scroll-view scroll-y scroll-into-view="{{bottomId}}" class="chat-scroll">
  <!-- 模式切换 -->
  <view class="mode-bar">
    <view class="mode-btn {{mode === 'ask' ? 'mode-on' : ''}}" bindtap="switchMode" data-mode="ask">问共生体</view>
    <view class="mode-btn {{mode === 'search' ? 'mode-on' : ''}}" bindtap="switchMode" data-mode="search">查原文</view>
  </view>

  <!-- 检索轮次过程 -->
  <view wx:for="{{steps}}" wx:key="index" class="step-row">
    <text class="step-text">◌ {{item}}</text>
  </view>

  <!-- 共生体作答 -->
  <view wx:if="{{answer}}" class="specimen-card answer-card">
    <text class="specimen-latin">symbiont · 共生体作答</text>
    <text class="answer-text">{{answer}}{{streaming ? "▍" : ""}}</text>
    <view wx:if="{{citations.length}}" class="citations">
      <text class="specimen-latin cite-title">citations · 引用来源</text>
      <text wx:for="{{citations}}" wx:key="chunk_id" class="cite-item">《{{item.document_title}}》#{{item.seq}}</text>
    </view>
  </view>

  <!-- 检索结果 -->
  <block wx:if="{{mode === 'search' && hits.length}}">
    <view wx:for="{{hits}}" wx:key="chunk_id" class="specimen-card hit-card">
      <view class="hit-head">
        <text class="hit-src">《{{item.document_title}}》 #{{item.seq}}</text>
        <text class="specimen-latin">sim {{item.score}}</text>
      </view>
      <text class="hit-content">{{item.content}}</text>
    </view>
  </block>
  <view wx:if="{{mode === 'search' && searched && !hits.length}}" class="empty-text">嗦囊空空如也</view>

  <!-- 错误 -->
  <view wx:if="{{error}}" class="error-card">
    <text>{{error}}</text>
  </view>

  <!-- 空态引导 -->
  <view wx:if="{{!answer && !steps.length && !hits.length && !error}}" class="empty-guide">
    <text class="empty-main">{{mode === 'ask' ? '向共生体提问，它自己去嗦囊里翻找答案' : '输入关键词，直查知识库原文分块'}}</text>
  </view>

  <view id="bottom"></view>
</scroll-view>

<view class="chat-input-bar">
  <input class="chat-input" placeholder="{{mode === 'ask' ? '问点什么…' : '关键词检索…'}}" value="{{input}}"
    bindinput="onInput" bindconfirm="send" confirm-type="send" confirm-hold="{{true}}"
    maxlength="2000" />
  <button class="empty-btn chat-send" bindtap="send" loading="{{streaming}}">发送</button>
</view>
