/* PeriNest Antenna 全局样式 */
page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #1f2937;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
}
.btn-primary {
  background: #c2410c;
  color: #fff;
  border-radius: 12rpx;
  text-align: center;
  padding: 20rpx 0;
}
.text-muted { color: #9ca3af; font-size: 24rpx; }
